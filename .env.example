# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/creator_platform"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# Paystack (used for all payments, creator payouts, subscriptions, and FV Tokens)
PAYSTACK_PUBLIC_KEY="pk_test_..."
PAYSTACK_SECRET_KEY="sk_test_..."

# Platform cut of creator subscriptions (separate from the 46% live gift fee).
SUBSCRIPTION_PLATFORM_FEE_PERCENT="20"
# Live gift platform cut.
PLATFORM_FEE_PERCENT="46"

# Cloudinary — used for photo/video uploads on the dashboard.
# Get these from cloudinary.com after creating a free account (see README "Media storage").
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Live streaming (LiveKit Cloud or self-hosted LiveKit)
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
