// Prisma schema for the creator subscription platform.
// Run `npm run db:push` (dev) or `npm run db:migrate` after setting DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FAN
  CREATOR
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum InterestGender {
  GIRLS
  GUYS
  TRANS
}

enum LiveCategory {
  NORMAL
  MATURE
  DARE
}

enum DareTier {
  SIMPLE
  BASIC
  EXTREME
}

enum ReportTargetType {
  USER
  POST
  MESSAGE
  LIVE_ROOM
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  username      String? @unique
  adultConfirmedAt DateTime?
  avatarUrl     String?
  role          Role     @default(FAN)
  createdAt     DateTime @default(now())
  bannedAt      DateTime?
  banReason     String?   @db.Text
  banExpiresAt  DateTime?

  // Creator-specific fields (null for fans)
  creatorProfile CreatorProfile?

  // Fan-specific relations
  subscriptions  Subscription[] @relation("FanSubscriptions")
  purchases      Purchase[]
  likes          Like[]
  giftsSent      Gift[] @relation("GiftSender")
  giftsReceived  Gift[] @relation("GiftRecipient")

  // Platform-wide (not per-creator) subscriptions, ambassador status, and
  // free-tier daily usage tracking
  isAmbassador          Boolean   @default(false)
  ambassadorRedeemedAt  DateTime?
  ambassadorCodeUsed    AmbassadorCode?
  platformSubscriptions PlatformSubscription[]
  dailyUsages           DailyUsage[]
  tokenWallet           TokenWallet?
  tokenPurchases        TokenPurchase[]
  tokenTransactions     TokenTransaction[]

  sessions Session[]
  accounts Account[]

  // Discovery preferences
  interestPreferences InterestPreference[]
  reportsFiled       ContentReport[] @relation("ReportReporter")
  reportsAgainst     ContentReport[] @relation("ReportTargetUser")
  moderationActions  ModerationAction[] @relation("ModerationTargetUser")
  moderationBy       ModerationAction[] @relation("ModerationAdmin")

  // Direct messaging relations
  sentDirectMessages     DirectMessage[] @relation("MessageSender")
  receivedDirectMessages DirectMessage[] @relation("MessageRecipient")

  followers   Follow[] @relation("FollowedUser")
  following   Follow[] @relation("FollowingUser")
  fanMessagesSent     FanMessage[] @relation("FanMessageSender")
  fanMessagesReceived FanMessage[] @relation("FanMessageRecipient")
  dareReveals         DareReveal[]
}

model CreatorProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username            String   @unique
  displayName         String
  bio                 String?  @db.Text
  avatarUrl           String?
  coverUrl            String?
  monthlyPriceCents   Int      @default(99900) // stored in NGN kobo; default ₦999/mo
  // Paystack creator payout setup
  paystackSubaccountCode String? @unique
  paystackSplitCode      String? @unique
  paystackPlanCode       String?
  payoutBankCode         String?
  payoutAccountLast4     String?
  onboardingComplete  Boolean  @default(false)
  createdAt           DateTime @default(now())

  // Identity verification — creators must be VERIFIED (and, unless an
  // ambassador, have an active CREATOR platform subscription) before they
  // can post or go live.
  verificationStatus      VerificationStatus @default(UNVERIFIED)
  verificationDocumentUrl String?
  verificationSubmittedAt DateTime?
  verifiedAt              DateTime?

  posts         Post[]
  subscribers   Subscription[] @relation("CreatorSubscribers")
  liveRooms     LiveRoom[]
  messages      DirectMessage[]
  tipMenuItems  TipMenuItem[]
  dareChallenges DareChallenge[]
}

model InterestPreference {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest  InterestGender
  createdAt DateTime       @default(now())

  @@unique([userId, interest])
  @@index([userId])
}

model TipMenuItem {
  id         String         @id @default(cuid())
  creatorId  String
  creator    CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  label      String
  emoji      String         @default("🎁")
  category   String         @default("HOT")
  amountCents Int            @default(0)
  tokenAmount Int            @default(100)
  sortOrder  Int            @default(0)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([creatorId, sortOrder])
}


model Subscription {
  id                    String   @id @default(cuid())
  fanId                 String
  fan                   User     @relation("FanSubscriptions", fields: [fanId], references: [id], onDelete: Cascade)
  creatorId             String
  creator               CreatorProfile @relation("CreatorSubscribers", fields: [creatorId], references: [id], onDelete: Cascade)
  // Paystack recurring subscription state
  paystackSubscriptionCode String? @unique
  paystackAuthorizationCode String?
  paystackPlanCode      String?
  nextChargeAt          DateTime?
  lastPaymentReference  String?
  amountKobo            Int?
  status                String   // pending, active, canceled, past_due, incomplete
  currentPeriodEnd      DateTime
  createdAt             DateTime @default(now())

  @@unique([fanId, creatorId])
  @@index([creatorId])
}

model Post {
  id            String   @id @default(cuid())
  creatorId     String
  creator       CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  caption       String?  @db.Text
  mediaUrl      String
  mediaType     String   // "image" | "video"
  isPaywalled   Boolean  @default(true)
  createdAt     DateTime @default(now())

  purchases     Purchase[]
  likes         Like[]
  reports       ContentReport[] @relation("ReportPost")

  @@index([creatorId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

// For one-off pay-per-view posts, separate from subscriptions
model Purchase {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  amountCents Int
  createdAt   DateTime @default(now())

  @@unique([userId, postId])
}

// --- NextAuth required models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LiveRoom {
  id          String   @id @default(cuid())
  creatorId   String
  creator     CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  roomName    String   @unique
  title       String
  status      String   @default("LIVE") // LIVE | ENDED
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  gifts       Gift[]
  reports     ContentReport[] @relation("ReportLiveRoom")
  createdAt   DateTime @default(now())
  category    LiveCategory @default(NORMAL)
  dareChallenges DareChallenge[]
  dareReveals DareReveal[]

  @@index([creatorId, status])
}

model ContentReport {
  id             String           @id @default(cuid())
  reporterId     String
  reporter       User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType     ReportTargetType
  targetId       String
  targetUserId   String?
  targetUser     User?            @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  reason         String
  details        String?          @db.Text
  status         ReportStatus    @default(OPEN)
  adminNote      String?          @db.Text
  reviewedAt     DateTime?
  reviewedById   String?
  createdAt      DateTime         @default(now())

  post           Post?            @relation("ReportPost", fields: [targetPostId], references: [id], onDelete: Cascade)
  targetPostId   String?
  message        DirectMessage?   @relation("ReportMessage", fields: [targetMessageId], references: [id], onDelete: Cascade)
  targetMessageId String?
  liveRoom       LiveRoom?        @relation("ReportLiveRoom", fields: [targetLiveRoomId], references: [id], onDelete: Cascade)
  targetLiveRoomId String?

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId, createdAt])
}


model ModerationAction {
  id          String   @id @default(cuid())
  adminId     String
  admin       User     @relation("ModerationAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetUser  User?    @relation("ModerationTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  action      String
  reason      String?  @db.Text
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([adminId, createdAt])
}

// An admin-issued code an ambassador redeems once to get free access
// (no payment required on either the FAN or CREATOR platform subscription).
model AmbassadorCode {
  id               String    @id @default(cuid())
  code             String    @unique
  note             String?
  redeemedByUserId String?   @unique
  redeemedBy       User?     @relation(fields: [redeemedByUserId], references: [id])
  redeemedAt       DateTime?
  createdAt        DateTime  @default(now())
}

// Platform-wide subscription — separate from the existing per-creator
// Subscription model above. FAN plans unlock unlimited feed + live across
// every creator; CREATOR plans are what a creator pays to be allowed to
// post/go live (waived for ambassadors).
model PaystackPlan {
  id         String   @id @default(cuid())
  key        String   @unique
  name       String
  planCode   String   @unique
  amount     Int
  currency   String   @default("NGN")
  interval   String
  createdAt  DateTime @default(now())
}

model PlatformSubscription {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planType              String   // "FAN" | "CREATOR"
  billingInterval       String   // "MONTHLY" | "YEARLY"
  status                String   // pending, active, canceled, past_due, incomplete
  paystackSubscriptionCode String? @unique
  paystackAuthorizationCode String?
  paystackPlanCode      String?
  nextChargeAt          DateTime?
  lastPaymentReference  String?
  currentPeriodEnd      DateTime
  createdAt             DateTime @default(now())

  @@index([userId, planType])
}

// One row per user per UTC day, tracking free-tier consumption for users
// without an active FAN PlatformSubscription (and who aren't ambassadors).
model DailyUsage {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime // truncated to UTC midnight
  feedViewCount  Int      @default(0)
  freeLiveUsed   Boolean  @default(false)
  freeLiveRoomId String?
  createdAt      DateTime @default(now())

  @@unique([userId, date])
}

model Gift {
  id                String   @id @default(cuid())
  liveRoomId        String
  liveRoom          LiveRoom @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  senderId          String
  sender            User     @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId       String
  recipient         User     @relation("GiftRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  amountCents        Int      @default(0)
  platformFeeCents   Int      @default(0)
  creatorAmountCents Int      @default(0)
  tokenAmount        Int      @default(0)
  platformFeeTokens  Int      @default(0)
  creatorTokenAmount Int      @default(0)
  isAdminGift       Boolean  @default(false)
  currency           String   @default("usd")
  status            String   @default("PENDING") // PENDING | PAID | FAILED | CANCELED
  createdAt         DateTime @default(now())
  paidAt            DateTime?

  @@index([liveRoomId, createdAt])
  @@index([recipientId, status])
}


model GiftSticker {
  id         String   @id @default(cuid())
  name       String   @unique
  emoji      String
  category   String   @default("HOT")
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TokenWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TokenPack {
  id         String   @id @default(cuid())
  name       String
  tokens     Int
  priceCents Int
  currency   String   @default("usd")
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  purchases  TokenPurchase[]

  @@index([isActive, sortOrder])
}

model TokenPurchase {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packId           String
  pack             TokenPack @relation(fields: [packId], references: [id], onDelete: Restrict)
  tokens           Int
  amountCents      Int
  currency         String   @default("usd")
  paystackReference String?  @unique
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  paidAt           DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model TokenTransaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  amount        Int
  balanceAfter  Int?
  referenceType String?
  referenceId   String?
  note          String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  follower   User     @relation("FollowingUser", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following  User     @relation("FollowedUser", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model FanMessage {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("FanMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("FanMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String   @db.Text
  createdAt   DateTime @default(now())
  readAt      DateTime?

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

model DareChallenge {
  id          String      @id @default(cuid())
  liveRoomId  String
  liveRoom    LiveRoom    @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  tier        DareTier
  prompt      String      @db.Text
  tokenAmount Int
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  reveals     DareReveal[]

  @@index([liveRoomId, tier, isActive])
}

model DareReveal {
  id              String   @id @default(cuid())
  dareId          String
  dare            DareChallenge @relation(fields: [dareId], references: [id], onDelete: Cascade)
  liveRoomId      String
  liveRoom        LiveRoom @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  fanId           String
  fan             User     @relation(fields: [fanId], references: [id], onDelete: Cascade)
  tokenAmount     Int
  platformFeeTokens Int
  creatorTokenAmount Int
  createdAt       DateTime @default(now())

  @@index([liveRoomId, createdAt])
  @@index([fanId, createdAt])
}

model DirectMessage {
  id          String   @id @default(cuid())
  creatorId   String
  creator     CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String   @db.Text
  createdAt   DateTime @default(now())
  readAt      DateTime?
  reports     ContentReport[] @relation("ReportMessage")

  @@index([creatorId, createdAt])
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}
